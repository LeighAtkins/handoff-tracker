# Local Postgres from docker-compose.yml (port 5433 to avoid clashing with other local Postgres instances)
DATABASE_URL="postgresql://handoff:handoff@localhost:5433/handoff?schema=public"

# Tracking aggregators (Phase 3). Set only the ones you use; never commit real keys.
SHIP24_API_KEY=
SEVENTEEN_TRACK_API_KEY=
AFTERSHIP_API_KEY=
