# Local Postgres from docker-compose.yml (port 5433 to avoid clashing with other local Postgres instances)
DATABASE_URL="postgresql://handoff:handoff@localhost:5433/handoff?schema=public"

# 4PX Open Platform (ADR-0004): AppKey/AppSecret from open.4px.com. Lookups use 4PX first when set.
# Test keys only work against the test platform: FOURPX_API_URL=https://open-test.4px.com/router/api/service
FOURPX_APP_KEY=
FOURPX_APP_SECRET=
FOURPX_API_URL=

# Tracking aggregators (Phase 3). Set only the ones you use; never commit real keys.
SHIP24_API_KEY=
SEVENTEEN_TRACK_API_KEY=
AFTERSHIP_API_KEY=

# Sign-in (Phase 4). See docs/deployment.md.
# 32+ random characters, e.g. `openssl rand -base64 32`. Required in production.
AUTH_SECRET=
# Lets you pick a seeded user at /signin. Only works on localhost. Never set this on a server.
AUTH_DEV_LOGIN=true
# Verified Google accounts at this domain may sign in as viewers.
ALLOWED_EMAIL_DOMAIN=
# Google OAuth client (Web application). Redirect URI: ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3100

# Trial metrics (Phase 4): replace with timings measured during the trial.
METRICS_MANUAL_CHECK_MINUTES=4
METRICS_APP_CHECK_MINUTES=0.5

# Overview: the door-to-door target, in days, that "delivered within target" is measured against.
DELIVERY_TARGET_DAYS=7
