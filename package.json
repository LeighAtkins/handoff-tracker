{
  "name": "handoff-tracker",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @handoff/db migrate:dev",
    "db:seed": "pnpm --filter @handoff/db seed",
    "db:reset": "pnpm --filter @handoff/db reset",
    "db:setup": "pnpm db:up && pnpm --filter @handoff/db migrate:deploy && pnpm db:seed",
    "worker": "pnpm --filter @handoff/worker start",
    "worker:loop": "pnpm --filter @handoff/worker start --loop",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "trial:aggregators": "pnpm --filter @handoff/carriers trial"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
